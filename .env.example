# Optional Docker host port. Copy this file to .env to override the default.
DATEDROP_PORT=8080

# Railway: mount a persistent volume at /data and set this service variable.
# DATABASE_PATH=/data/datedrop.db

# Railway's default root-owned volume is not writable by this image's USER node.
# With the current image and default volume permissions, also set:
# RAILWAY_RUN_UID=0
# This runs the Railway service as root; omit it if the volume is already writable
# by node (UID/GID 1000). Changing ownership at image build time does not change
# the permissions of Railway's volume mounted later at runtime.
# Do not set PORT manually: Railway supplies it; Express falls back to 4000 locally.
# NODE_ENV=production, HOST=0.0.0.0, and CLIENT_DIST_PATH=/app/client/dist
# are already set by the Dockerfile and need no Railway overrides.
